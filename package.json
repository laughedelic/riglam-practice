{
  "name": "riglam-practice",
  "version": "0.5.0",
  "private": true,
  "description": "Practice app for Buddhist logic and debate (Dudra, Tarig): one source, an installable PWA and a Claude artifact build.",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite --mode pwa",
    "build": "npm run build:pwa && npm run build:artifact",
    "build:pwa": "vite build --mode pwa",
    "build:artifact": "node scripts/build-artifact.mjs",
    "preview": "vite preview --mode pwa",
    "lint": "eslint .",
    "typecheck": "tsc -p . && tsc -p src/app && tsc -p worker",
    "test": "npm run build && npm run test:unit && npm run test:e2e",
    "check:fast": "npm run lint && npm run typecheck && npm run test:unit",
    "check": "npm run lint && npm run typecheck && npm test",
    "artifact:verify": "node scripts/artifact-verify.mjs",
    "staging": "node scripts/staging.mjs",
    "data:key": "node scripts/data.mjs key",
    "data:import": "node scripts/data.mjs import",
    "data:export": "node scripts/data.mjs export",
    "data:check": "node scripts/data.mjs check",
    "data:publish": "node scripts/data.mjs publish",
    "data:sql": "node scripts/data.mjs sql",
    "data:fixture": "node scripts/data.mjs fixture",
    "icons": "node scripts/make-icons.mjs",
    "social": "node scripts/make-social.mjs",
    "fonts": "node scripts/fetch-fonts.mjs",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261012.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.56.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "sharp": "^0.35.5",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.4",
    "workbox-build": "^7.4.1",
    "workbox-window": "^7.4.1"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@simplewebauthn/server": "^14.0.3",
    "hono": "^4.13.13"
  }
}
