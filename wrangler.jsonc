{
  // Hosting for the installable PWA and its small server: Cloudflare Workers with static assets. The Worker script
  // (worker/, docs/SERVER.md) answers /api/* only; every other request is served from dist/pwa without running it.
  // CI deploys with `wrangler deploy` (production) and `wrangler versions upload` (previews); see docs/DEPLOY.md.
  "name": "riglam-practice",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  // Pinned so that a deploy never re-enables an address that was switched off in the dashboard (for example when
  // Cloudflare Access is set up), and so wrangler does not warn that it is enabling them by default.
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./dist/pwa",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  // Only the lines the Worker writes itself (errors, with no text of any question). No line per request.
  "observability": { "enabled": true, "logs": { "invocation_logs": false } },
  // The tutor's settings (worker/config.ts has the same values as defaults). A change is a pull request.
  // Dollars are US dollars per UTC day. The secrets ANTHROPIC_API_KEY and RIGLAM_DATA_KEY are not here: `wrangler secret put`.
  "vars": {
    "TUTOR_MODEL": "claude-sonnet-5-5",
    "TUTOR_EFFORT": "medium",
    "TUTOR_MAX_TOKENS": "6000",
    "TUTOR_MAX_ROUNDS": "4",
    "DEVICE_DAILY_BUDGET_USD": "0.40",
    "GLOBAL_DAILY_BUDGET_USD": "4",
    "RESERVE_USD": "0.05"
  }
  // The D1 database for the budget counters is added here once it exists (docs/SERVER.md):
  //   "d1_databases": [{ "binding": "DB", "database_name": "riglam-practice", "database_id": "<id>", "migrations_dir": "worker/migrations" }]
  // Until then the tutor is off and everything else works.
}
